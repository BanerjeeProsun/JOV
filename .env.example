# JOV.si Environment Variables Template
# Copy this file to .env and customize values for your deployment.
# NEVER commit .env to version control.

# Core Product & Safety Configuration
JOVSI_PRODUCT_NAME="JOV.si"
JOVSI_AUTONOMY_LEVEL="L0_DRY_RUN"
JOVSI_ALLOW_REAL_SUBMISSION=false
JOVSI_SUITABILITY_FLOOR=65
JOVSI_DAILY_CAP_GLOBAL=10
JOVSI_DAILY_CAP_PER_PORTAL=5
JOVSI_DAILY_CAP_PER_COMPANY=1
JOVSI_TIMEZONE="Asia/Kolkata"
JOVSI_MIN_EVIDENCE_LEVEL="E2"

# Server & Database
JOVSI_API_HOST="127.0.0.1"
JOVSI_API_PORT=8000
JOVSI_MOCK_PORTAL_PORT=8765
JOVSI_DATABASE_URL="sqlite:///./jovsi.db"
JOVSI_ARTIFACTS_DIR="./artifacts"
JOVSI_SECRET_KEY="replace-with-a-random-32-byte-secret-key-for-hmac-sessions"

# Allowed submission hosts (default strictly loopback for safety)
JOVSI_SUBMIT_HOST_ALLOWLIST=["127.0.0.1:8765"]

# LLM Integration (Google Gemini)
# Provider choices: gemini (default), fallback (pure heuristic deterministic)
JOVSI_LLM_ENABLED=false
JOVSI_LLM_PROVIDER="gemini"
JOVSI_LLM_MODEL="gemini-2.5-flash"
# Provide either JOVSI_LLM_API_KEY or GEMINI_API_KEY:
JOVSI_LLM_API_KEY="your-gemini-api-key-here"
# GEMINI_API_KEY="your-gemini-api-key-here"
